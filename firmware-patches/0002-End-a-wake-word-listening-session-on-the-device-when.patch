+void Application::StartListenEndCheck() {
+    listen_end_.Start(esp_timer_get_time() / 1000);
+    // esp_timer_stop returns ESP_ERR_INVALID_STATE when not running, and both
+    // return ESP_ERR_INVALID_ARG on a null handle (timer creation failed).
+    esp_timer_stop(listen_end_timer_);
+    esp_timer_start_periodic(listen_end_timer_, 100 * 1000);
+}
+
+// The only place the check ends: when the session ended, and on the next tick
+// after the device left listening some other way (a tap, the 30 s stop).
+void Application::StopListenEndCheck() {
+    wake_word_session_ = false;
+    listen_end_.Stop();
+    esp_timer_stop(listen_end_timer_);
+}
+
+void Application::HandleListenEndCheckEvent() {
+    if (GetDeviceState() != kDeviceStateListening || !wake_word_session_) {
+        StopListenEndCheck();
+        return;
+    }
+    auto end = listen_end_.Update(esp_timer_get_time() / 1000, audio_service_.IsVoiceDetected());
+    if (end == stackchan::ListenEnd::kNone) {
+        return;
+    }
+    ESP_LOGI(TAG, "Wake-word listening ended: %s", stackchan::ListenEndName(end));
+    StopListenEndCheck();
+    StopListening();
+}
