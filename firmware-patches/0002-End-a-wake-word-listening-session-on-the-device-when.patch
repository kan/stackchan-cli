diff --git a/firmware/host_test/test_listen_end_detector.cc b/firmware/host_test/test_listen_end_detector.cc
new file mode 100644
index 0000000..54b44e8
--- /dev/null
+++ b/firmware/host_test/test_listen_end_detector.cc
@@ -0,0 +1,134 @@
+#include "listen_end_detector.h"
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+
+namespace {
+
+using stackchan::ListenEnd;
+using stackchan::ListenEndDetector;
+
+constexpr int64_t kTick = 100;
+
+// Feeds `speaking` every tick from `from` (inclusive) to `to` (exclusive) and
+// returns the first end reason with the time it was reported.
+struct Outcome {
+    ListenEnd end = ListenEnd::kNone;
+    int64_t at = -1;
+};
+
+Outcome Feed(ListenEndDetector& d, int64_t from, int64_t to, bool speaking) {
+    for (int64_t t = from; t < to; t += kTick) {
+        ListenEnd end = d.Update(t, speaking);
+        if (end != ListenEnd::kNone) {
+            return {end, t};
+        }
+    }
+    return {};
+}
+
+TEST(ListenEndDetector, StopsAfterSilenceFollowingSpeech) {
+    ListenEndDetector d;
+    d.Start(0);
+    EXPECT_EQ(Feed(d, 0, 1000, false).end, ListenEnd::kNone);
+    EXPECT_EQ(Feed(d, 1000, 3000, true).end, ListenEnd::kNone);
+    Outcome r = Feed(d, 3000, 6000, false);
+    EXPECT_EQ(r.end, ListenEnd::kSilence);
+    EXPECT_EQ(r.at, 4000);  // 1 s after the speech ended
+    EXPECT_FALSE(d.active());
+}
+
+TEST(ListenEndDetector, ShortPauseDoesNotStop) {
+    ListenEndDetector d;
+    d.Start(0);
+    Feed(d, 0, 1000, false);
+    Feed(d, 1000, 2000, true);
+    EXPECT_EQ(Feed(d, 2000, 2500, false).end, ListenEnd::kNone);  // 0.5 s pause
+    EXPECT_EQ(Feed(d, 2500, 3500, true).end, ListenEnd::kNone);
+    Outcome r = Feed(d, 3500, 6000, false);
+    EXPECT_EQ(r.end, ListenEnd::kSilence);
+    EXPECT_EQ(r.at, 4500);
+}
+
+TEST(ListenEndDetector, StopsWhenNothingIsSaid) {
+    ListenEndDetector d;
+    d.Start(0);
+    Outcome r = Feed(d, 0, 10000, false);
+    EXPECT_EQ(r.end, ListenEnd::kNoSpeech);
+    EXPECT_EQ(r.at, 5000);
+}
+
+TEST(ListenEndDetector, StartSoundIsNotSpeech) {
+    ListenEndDetector d;
+    d.Start(0);
+    // The popup at the start, then silence: no speech was heard.
+    EXPECT_EQ(Feed(d, 0, 600, true).end, ListenEnd::kNone);
+    Outcome r = Feed(d, 600, 10000, false);
+    EXPECT_EQ(r.end, ListenEnd::kNoSpeech);
+}
+
+TEST(ListenEndDetector, LateVadOnStartSoundIsNotSpeech) {
+    // Seen on the device: the VAD reported the popup as speech until 0.8 s,
+    // past the ignored window, and the session stopped 1 s later with only
+    // the popup recorded.
+    ListenEndDetector d;
+    d.Start(0);
+    EXPECT_EQ(Feed(d, 0, 900, true).end, ListenEnd::kNone);
+    EXPECT_EQ(Feed(d, 900, 2500, false).end, ListenEnd::kNone);
+    EXPECT_EQ(Feed(d, 2500, 3500, true).end, ListenEnd::kNone);  // the user
+    Outcome r = Feed(d, 3500, 8000, false);
+    EXPECT_EQ(r.end, ListenEnd::kSilence);
+    EXPECT_EQ(r.at, 4500);
+}
+
+TEST(ListenEndDetector, SpeechThroughTheStartSoundCounts) {
+    // Talking straight through the popup: voice still there at 1.5 s is the
+    // user, and the session ends 1 s after they stop.
+    ListenEndDetector d;
+    d.Start(0);
+    EXPECT_EQ(Feed(d, 0, 2000, true).end, ListenEnd::kNone);
+    Outcome r = Feed(d, 2000, 10000, false);
+    EXPECT_EQ(r.end, ListenEnd::kSilence);
+    EXPECT_EQ(r.at, 3000);
+}
+
+TEST(ListenEndDetector, LongSpeechThroughTheStartSoundIsNotCutAtNoSpeech) {
+    ListenEndDetector d;
+    d.Start(0);
+    EXPECT_EQ(Feed(d, 0, 6000, true).end, ListenEnd::kNone);  // past the 5 s no-speech limit
+    Outcome r = Feed(d, 6000, 10000, false);
+    EXPECT_EQ(r.end, ListenEnd::kSilence);
+    EXPECT_EQ(r.at, 7000);
+}
+
+TEST(ListenEndDetector, StopsAtTheMaximum) {
+    ListenEndDetector d;
+    d.Start(0);
+    Feed(d, 0, 1000, false);
+    Outcome r = Feed(d, 1000, 20000, true);  // never stops talking
+    EXPECT_EQ(r.end, ListenEnd::kMax);
+    EXPECT_EQ(r.at, 10000);
+}
+
+TEST(ListenEndDetector, ReportsOnceAndRestarts) {
+    ListenEndDetector d;
+    d.Start(0);
+    EXPECT_EQ(Feed(d, 0, 10000, false).end, ListenEnd::kNoSpeech);
+    EXPECT_EQ(d.Update(10000, false), ListenEnd::kNone);  // stopped itself
+
+    d.Start(20000);
+    EXPECT_TRUE(d.active());
+    Outcome r = Feed(d, 20000, 30000, false);
+    EXPECT_EQ(r.end, ListenEnd::kNoSpeech);
+    EXPECT_EQ(r.at, 25000);
+}
+
+TEST(ListenEndDetector, StoppedDetectorReportsNothing) {
+    ListenEndDetector d;
+    d.Start(0);
+    d.Stop();
+    EXPECT_EQ(Feed(d, 0, 20000, false).end, ListenEnd::kNone);
+}
+
+}  // namespace
