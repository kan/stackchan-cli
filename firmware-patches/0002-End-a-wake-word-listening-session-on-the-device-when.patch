diff --git a/firmware/main/listen_end_detector.h b/firmware/main/listen_end_detector.h
new file mode 100644
index 0000000..f12fcb7
--- /dev/null
+++ b/firmware/main/listen_end_detector.h
@@ -0,0 +1,103 @@
+#pragma once
+
+// stackchan-cli: decide when a wake-word listening session has ended, from
+// the AFE's voice activity. Upstream xiaozhi leaves this to the server, but
+// the stackchan-mcp gateway only waits for the device's listen.stop, so
+// without this a wake-word session runs until a screen tap or the board's
+// 30 s safety stop (PollTouchpad); kMaxMs here always ends it first.
+// Pure logic (no ESP-IDF), tested in host_test.
+
+#include <cstdint>
+
+namespace stackchan {
+
+enum class ListenEnd {
+    kNone,
+    kSilence,
+    kNoSpeech,
+    kMax,
+};
+
+inline const char* ListenEndName(ListenEnd end) {
+    switch (end) {
+        case ListenEnd::kSilence: return "silence after speech";
+        case ListenEnd::kNoSpeech: return "no speech";
+        case ListenEnd::kMax: return "max duration";
+        default: return "none";
+    }
+}
+
+class ListenEndDetector {
+public:
+    // Voice in the first moments is the device's own start sound (the
+    // listening popup is played as the microphone opens, and there is no
+    // AEC on this board), not the user. The VAD lags behind the audio, so
+    // its "speaking" can outlast this window: speech is counted only after
+    // the VAD has also reported silence once past it, or from kArmByMs on
+    // (voice that long is the user talking straight through the sound).
+    static constexpr int64_t kIgnoreFirstMs = 700;
+    static constexpr int64_t kArmByMs = 1500;
+    static constexpr int64_t kSilenceAfterSpeechMs = 1000;  // speech then this much silence
+    static constexpr int64_t kNoSpeechMs = 5000;            // no speech at all since the start
+    static constexpr int64_t kMaxMs = 10000;                // whole session
+
+    void Start(int64_t now_ms) {
+        active_ = true;
+        started_ms_ = now_ms;
+        armed_ = false;
+        heard_speech_ = false;
+        speaking_ = false;
+        silence_since_ms_ = now_ms;
+    }
+
+    void Stop() { active_ = false; }
+    bool active() const { return active_; }
+
+    // Update with the current voice activity. Returns the reason the session
+    // has ended, once (the detector stops itself), or kNone.
+    ListenEnd Update(int64_t now_ms, bool speaking) {
+        if (!active_) {
+            return ListenEnd::kNone;
+        }
+        if (!armed_) {
+            int64_t elapsed = now_ms - started_ms_;
+            if (elapsed >= kArmByMs) {
+                armed_ = true;  // still voice: the user, so count it
+            } else if (elapsed >= kIgnoreFirstMs && !speaking) {
+                armed_ = true;  // the start sound is over
+            } else {
+                speaking = false;
+            }
+        }
+        if (speaking) {
+            heard_speech_ = true;
+        } else if (speaking_) {
+            silence_since_ms_ = now_ms;
+        }
+        speaking_ = speaking;
+
+        ListenEnd end = ListenEnd::kNone;
+        if (now_ms - started_ms_ >= kMaxMs) {
+            end = ListenEnd::kMax;
+        } else if (!heard_speech_ && now_ms - started_ms_ >= kNoSpeechMs) {
+            end = ListenEnd::kNoSpeech;
+        } else if (heard_speech_ && !speaking_ &&
+                   now_ms - silence_since_ms_ >= kSilenceAfterSpeechMs) {
+            end = ListenEnd::kSilence;
+        }
+        if (end != ListenEnd::kNone) {
+            active_ = false;
+        }
+        return end;
+    }
+
+private:
+    bool active_ = false;
+    int64_t started_ms_ = 0;
+    bool armed_ = false;  // past the start sound
+    bool heard_speech_ = false;
+    bool speaking_ = false;
+    int64_t silence_since_ms_ = 0;
+};
+
+}  // namespace stackchan
