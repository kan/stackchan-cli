From 3ec81dc7ef325f6170a36633593f26de6a565113 Mon Sep 17 00:00:00 2001
From: stackchan-cli <stackchan-cli@localhost>
Date: Mon, 26 Oct 2026 00:11:46 +0900
Subject: [PATCH 4/5] stackchan: aggressive wake word detection (DET_MODE_95)

---
 firmware/main/Kconfig.projbuild                 | 7 +++++++
 firmware/main/audio/wake_words/afe_wake_word.cc | 8 +++++++-
 firmware/main/boards/stackchan/config.json      | 3 ++-
 3 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/firmware/main/Kconfig.projbuild b/firmware/main/Kconfig.projbuild
index 29013c0..1345831 100644
--- a/firmware/main/Kconfig.projbuild
+++ b/firmware/main/Kconfig.projbuild
@@ -894,6 +894,13 @@ config SEND_WAKE_WORD_DATA
     help
         Send wake word data to the server as the first message of the conversation and wait for response
 
+config WAKE_WORD_DET_MODE_95
+    bool "Aggressive wake word detection (DET_MODE_95)"
+    default n
+    depends on USE_AFE_WAKE_WORD
+    help
+        Use WakeNet's aggressive threshold: more wake words detected, more false wakes.
+
 config WAKE_WORD_DETECTION_IN_LISTENING
     bool "Enable Wake Word Detection in Listening Mode"
     default n
diff --git a/firmware/main/audio/wake_words/afe_wake_word.cc b/firmware/main/audio/wake_words/afe_wake_word.cc
index 8fc5fef..8d7b608 100644
--- a/firmware/main/audio/wake_words/afe_wake_word.cc
+++ b/firmware/main/audio/wake_words/afe_wake_word.cc
@@ -76,7 +76,13 @@ bool AfeWakeWord::Initialize(AudioCodec* codec, srmodel_list_t* models_list) {
     afe_config->afe_perferred_core = 1;
     afe_config->afe_perferred_priority = 1;
     afe_config->memory_alloc_mode = AFE_MEMORY_ALLOC_MORE_PSRAM;
-    
+#if CONFIG_WAKE_WORD_DET_MODE_95
+    // stackchan-cli: the aggressive threshold. With the default (DET_MODE_90)
+    // "Hi, Stack Chan" spoken by a Japanese speaker was detected about once
+    // in five tries.
+    afe_config->wakenet_mode = DET_MODE_95;
+#endif
+
     afe_iface_ = esp_afe_handle_from_config(afe_config);
     afe_data_ = afe_iface_->create_from_config(afe_config);
 
diff --git a/firmware/main/boards/stackchan/config.json b/firmware/main/boards/stackchan/config.json
index c520b72..cbb0e85 100644
--- a/firmware/main/boards/stackchan/config.json
+++ b/firmware/main/boards/stackchan/config.json
@@ -12,7 +12,8 @@
                 "CONFIG_STACKCHAN_SERVO_FEETECH=y",
                 "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                 "CONFIG_SR_WN_WN9_HISTACKCHAN_TTS3=y",
-                "CONFIG_SEND_WAKE_WORD_DATA=n"
+                "CONFIG_SEND_WAKE_WORD_DATA=n",
+                "CONFIG_WAKE_WORD_DET_MODE_95=y"
             ]
         }
     ]
